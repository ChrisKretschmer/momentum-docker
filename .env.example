# Copy to .env and adjust. .env is git-ignored.

# VNC password (only the first 8 characters are used by VNC auth).
# Also required when connecting via noVNC in the browser.
# Leave empty to get a random password on each start (see `docker compose logs`).
VNC_PASSWORD=

# Classic VNC client access.
# Bind address: 127.0.0.1 = only local / via SSH tunnel, 0.0.0.0 = all interfaces.
VNC_BIND=127.0.0.1
VNC_PORT=5901

# Browser access via noVNC: http://<host>:6080/
NOVNC_ENABLED=true
NOVNC_BIND=127.0.0.1
NOVNC_PORT=6080

TZ=Europe/Berlin
RESOLUTION=1920x1080

# Image to pull; `docker compose build` builds it locally instead.
# MOMENTUM_IMAGE=ghcr.io/chriskretschmer/momentum-docker:latest
